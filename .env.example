# ONE TUNNE Logistics — приклад змінних середовища.
# Скопіюйте у .env і заповніть. НЕ комітьте .env у GitHub. Секретів тут немає.

# --- Демонстраційний режим (автономно, без Shopify і платних сервісів) ---
DEMO_MODE=true
# Каталог вбудованої бази PGlite для демо; "memory" — без збереження між перезапусками.
DEMO_DATA_DIR=.data/demo-db
# Необов'язково: пароль для доступу до демо (потрібен SESSION_SECRET).
# DEMO_PASSWORD=
# Випадковий рядок ≥ 32 символів (підпис cookie). Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Лише на хостингу за HTTPS-проксі (Render/Fly — 1): коректний https і IP клієнта.
# Локально не вмикайте (за замовчуванням вимкнено). Файл .env підхоплюють `npm run dev`, `npm run demo`, `npm start`.
# TRUST_PROXY=1

# --- Робочий режим (етап 2+): Embedded Shopify App ---
# Демо НЕ можна вмикати разом із ключами Shopify у production.
# DATABASE_URL=postgres://user:password@host:5432/onetunne
# AUTO_MIGRATE=true
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=https://your-app-host.example.com
# SCOPES=write_orders,read_products,read_inventory
# Shopify user ID власника (через кому). Інші користувачі отримують роль «Працівник».
# OWNER_SHOPIFY_USER_IDS=

# --- Майбутні інтеграції (не використовуються на етапі 1) ---
# NOVA_GLOBAL_API_KEY=          # етап 3, після отримання документації та ключів
# ANTHROPIC_API_KEY=            # етап 7 (ШІ-асистент)
# TELEGRAM_BOT_TOKEN=           # етап 8
